diff -ruN '--exclude=build' '--exclude=flake.lock' a/src/layout/stage.c b/src/layout/stage.c
--- a/src/layout/stage.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/layout/stage.c	2026-09-26 15:26:58.478748983 +0200
@@ -0,0 +1,675 @@
+#include "mango/layout/stage.h"
+#include "mango/animation/client.h"
+#include "mango/common/server.h"
+#include "mango/common/util.h"
+#include "mango/layout/arrange.h"
+#include "mango/layout/layout.h"
+#include "mango/manage/client.h"
+#include "mango/manage/layer.h"
+#include "mango/manage/monitor.h"
+#include "mango/overview/overview.h"
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_xdg_shell.h>
+#include <wlr/util/edges.h>
+
+#define STAGE_CENTER_MAX 4
+// Scale right next to the center square and at the monitor edge.
+#define STAGE_SCALE_MAX 0.6f
+#define STAGE_SCALE_MIN 0.25f
+// A shake is this many direction flips, each at least this far, this fast.
+#define STAGE_SHAKE_FLIPS 4
+#define STAGE_SHAKE_TRAVEL 40.0
+#define STAGE_SHAKE_WINDOW_MS 800
+
+static struct {
+	Client *c;
+	double ext;
+	int32_t dir;
+	uint32_t flips[STAGE_SHAKE_FLIPS];
+	int32_t nflips;
+	bool fired;
+} shake;
+
+// Drag state that must outlive the begin-move call.
+static struct {
+	Client *c;
+	bool was_staged;
+	struct wlr_box origin;
+} drag;
+
+bool is_stage_layout(Monitor *m) {
+	return m && !m->isoverview &&
+		   m->pertag->ltidxs[get_mon_curtag(m)]->id == STAGE;
+}
+
+// As wide as the monitor is tall, so it lines up with a bar sized the same way.
+static struct wlr_box stage_center_box(Monitor *m) {
+	int32_t side = MANGO_MIN(m->m.height, m->w.width);
+	return (struct wlr_box){
+		.x = m->m.x + (m->m.width - side) / 2,
+		.y = m->w.y,
+		.width = side,
+		.height = m->w.height,
+	};
+}
+
+static bool stage_in_center(Monitor *m, double x, double y) {
+	struct wlr_box s = stage_center_box(m);
+	return wlr_box_contains_point(&s, x, y);
+}
+
+static float stage_scale_at(Monitor *m, double x) {
+	struct wlr_box s = stage_center_box(m);
+	double t = 0;
+	if (x < s.x && s.x > m->m.x)
+		t = (s.x - x) / (double)(s.x - m->m.x);
+	else if (x > s.x + s.width && m->m.x + m->m.width > s.x + s.width)
+		t = (x - (s.x + s.width)) /
+			(double)(m->m.x + m->m.width - (s.x + s.width));
+	t = MANGO_MAX(0.0, MANGO_MIN(1.0, t));
+	return STAGE_SCALE_MAX - (STAGE_SCALE_MAX - STAGE_SCALE_MIN) * (float)t;
+}
+
+void stage_content_size(Client *c, int32_t *w, int32_t *h) {
+	if (c->isstaged && c->stage_lw > 0 && c->stage_lh > 0) {
+		*w = c->stage_lw;
+		*h = c->stage_lh;
+		return;
+	}
+	*w = c->geom.width - 2 * (int32_t)c->bw;
+	*h = c->geom.height - 2 * (int32_t)c->bw;
+}
+
+static struct wlr_box stage_box_at(Client *c, double cx, double cy, float s) {
+	int32_t w = (int32_t)roundf(c->stage_lw * s) + 2 * (int32_t)c->bw;
+	int32_t h = (int32_t)roundf(c->stage_lh * s) + 2 * (int32_t)c->bw;
+	return (struct wlr_box){
+		.x = (int32_t)round(cx - w / 2.0),
+		.y = (int32_t)round(cy - h / 2.0),
+		.width = w,
+		.height = h,
+	};
+}
+
+static float stage_current_scale(Client *c) {
+	return c->stage_scale > 0.f ? c->stage_scale : STAGE_SCALE_MAX;
+}
+
+// The box on screen is logical size times scale. Box changes that did not come
+// from a scale change (resize grabs, keyboard resizes) resize the client.
+void stage_sync_logical(Client *c) {
+	if (!c->isstaged || c->stage_scale <= 0.f)
+		return;
+	int32_t bw2 = 2 * (int32_t)c->bw;
+	int32_t lw = (int32_t)roundf((c->geom.width - bw2) / c->stage_scale);
+	int32_t lh = (int32_t)roundf((c->geom.height - bw2) / c->stage_scale);
+	// Rounding from scaled boxes is not a resize.
+	if (abs(lw - c->stage_lw) > 2)
+		c->stage_lw = lw;
+	if (abs(lh - c->stage_lh) > 2)
+		c->stage_lh = lh;
+}
+
+// Popups are anchored to content that is about to change scale; closing them
+// matches what toolkits do when their window moves.
+static void stage_close_popups(Client *c) {
+	if (client_is_x11(c))
+		return;
+	struct wlr_xdg_popup *popup, *tmp;
+	wl_list_for_each_safe(popup, tmp, &c->surface.xdg->popups, link)
+		wlr_xdg_popup_destroy(popup);
+}
+
+static void stage_client(Client *c, struct wlr_box box) {
+	if (!c->isstaged) {
+		struct wlr_box content;
+		client_get_geometry(c, &content);
+		if (content.width <= 0 || content.height <= 0)
+			stage_content_size(c, &content.width, &content.height);
+
+		stage_close_popups(c);
+		if (!c->stage_popups.prev)
+			wl_list_init(&c->stage_popups);
+		c->stage_lw = content.width;
+		c->stage_lh = content.height;
+		c->isstaged = true;
+		c->isfloating = 1;
+		c->iscustomsize = 1;
+		client_set_tiled(c, WLR_EDGE_NONE);
+		overview_backup_surface(c);
+	}
+	if (c->stage_lw > 0)
+		c->stage_scale =
+			(float)(box.width - 2 * (int32_t)c->bw) / (float)c->stage_lw;
+	c->float_geom = box;
+	resize(c, box, 0);
+}
+
+static void unstage_client(Client *c) {
+	if (!c->isstaged)
+		return;
+	stage_close_popups(c);
+	c->isstaged = false;
+	c->isfloating = 0;
+	if (!c->mon || !c->mon->isoverview) {
+		overview_destroy_card(c);
+		if (c->overview_scene_surface) {
+			c->scene_surface = c->overview_scene_surface;
+			c->overview_scene_surface = NULL;
+			wlr_scene_node_set_enabled(&c->scene_surface->node, true);
+		}
+	}
+	client_set_tiled(c, WLR_EDGE_TOP | WLR_EDGE_BOTTOM | WLR_EDGE_LEFT |
+							WLR_EDGE_RIGHT);
+}
+
+void stage_adopt_size(Client *c, int32_t w, int32_t h) {
+	if (!c->isstaged || w <= 0 || h <= 0 ||
+		(w == c->stage_lw && h == c->stage_lh))
+		return;
+	float s = stage_current_scale(c);
+	c->stage_lw = w;
+	c->stage_lh = h;
+	struct wlr_box box =
+		stage_box_at(c, c->geom.x + c->geom.width / 2.0,
+					 c->geom.y + c->geom.height / 2.0, s);
+	if (c == server.grab_client) {
+		server.grab_client->float_geom = box;
+		return;
+	}
+	c->float_geom = box;
+	resize(c, box, 0);
+}
+
+void stage_release_all(Monitor *m) {
+	Client *c;
+	wl_list_for_each(c, &server.clients, link) {
+		if (c->isstaged && VISIBLEON(c, m))
+			unstage_client(c);
+	}
+}
+
+static int32_t stage_center_count(Monitor *m, Client *skip) {
+	Client *c;
+	int32_t n = 0;
+	wl_list_for_each(c, &server.clients, link) {
+		if (c != skip && VISIBLEON(c, m) && ISTILED(c))
+			n++;
+	}
+	return n;
+}
+
+Client *stage_tile_at_cursor(Monitor *m, Client *skip) {
+	Client *c;
+	if (!stage_in_center(m, server.cursor->x, server.cursor->y))
+		return NULL;
+	wl_list_for_each(c, &server.clients, link) {
+		if (c != skip && VISIBLEON(c, m) && ISTILED(c) &&
+			wlr_box_contains_point(&c->geom, server.cursor->x,
+								   server.cursor->y))
+			return c;
+	}
+	return NULL;
+}
+
+// Side a stashed window belongs to: where it sits, or the emptier side while it
+// is still inside the center square.
+static bool stage_on_left(Monitor *m, Client *c, int32_t nleft,
+						  int32_t nright) {
+	struct wlr_box s = stage_center_box(m);
+	double cx = c->geom.x + c->geom.width / 2.0;
+	if (cx < s.x)
+		return true;
+	if (cx > s.x + s.width)
+		return false;
+	return nleft <= nright;
+}
+
+// Fits a column of stashed windows against the square's edge, one slot each.
+static void stage_align_column(Monitor *m, Client **list, int32_t k,
+							   bool left) {
+	struct wlr_box s = stage_center_box(m);
+	int32_t gap = server.enable_gaps ? m->gappih : 0;
+	int32_t outer = server.enable_gaps ? m->gappoh : 0;
+	int32_t col_w = left ? s.x - m->w.x - gap - outer
+						 : m->w.x + m->w.width - (s.x + s.width) - gap - outer;
+	int32_t top = m->w.y + (server.enable_gaps ? m->gappov : 0);
+	int32_t avail_h = m->w.height - 2 * (top - m->w.y);
+	if (k <= 0 || col_w <= 0)
+		return;
+	int32_t slot_h = (avail_h - (k - 1) * gap) / k;
+
+	for (int32_t i = 0; i < k; i++) {
+		Client *c = list[i];
+		int32_t bw2 = 2 * (int32_t)c->bw;
+		float sw = (float)(col_w - bw2) / c->stage_lw;
+		float sh = (float)(slot_h - bw2) / c->stage_lh;
+		float sc = MANGO_MIN(STAGE_SCALE_MAX, MANGO_MIN(sw, sh));
+		int32_t w = (int32_t)roundf(c->stage_lw * sc) + bw2;
+		int32_t h = (int32_t)roundf(c->stage_lh * sc) + bw2;
+		struct wlr_box box = {
+			.x = left ? s.x - gap - w : s.x + s.width + gap,
+			.y = top + i * (slot_h + gap) + (slot_h - h) / 2,
+			.width = w,
+			.height = h,
+		};
+		stage_client(c, box);
+	}
+}
+
+static int cmp_center_y(const void *a, const void *b) {
+	const Client *ca = *(Client *const *)a, *cb = *(Client *const *)b;
+	int32_t ya = ca->geom.y + ca->geom.height / 2;
+	int32_t yb = cb->geom.y + cb->geom.height / 2;
+	return (ya > yb) - (ya < yb);
+}
+
+// Lines every stashed window up in two tidy columns, one per side.
+static void stage_align_sides(Monitor *m, Client *skip) {
+	Client *c;
+	int32_t n = 0, nl = 0, nr = 0;
+	wl_list_for_each(c, &server.clients, link) {
+		if (c != skip && c->isstaged && VISIBLEON(c, m))
+			n++;
+	}
+	if (n == 0)
+		return;
+
+	Client **left = ecalloc(n, sizeof(*left));
+	Client **right = ecalloc(n, sizeof(*right));
+	wl_list_for_each(c, &server.clients, link) {
+		if (c == skip || !c->isstaged || !VISIBLEON(c, m))
+			continue;
+		if (stage_on_left(m, c, nl, nr))
+			left[nl++] = c;
+		else
+			right[nr++] = c;
+	}
+	qsort(left, nl, sizeof(*left), cmp_center_y);
+	qsort(right, nr, sizeof(*right), cmp_center_y);
+	stage_align_column(m, left, nl, true);
+	stage_align_column(m, right, nr, false);
+	free(left);
+	free(right);
+}
+
+// Stashes a window without disturbing the ones already on the sides: below the
+// last one on the emptier side, against the square's edge.
+static void stage_stash_free(Monitor *m, Client *c) {
+	struct wlr_box s = stage_center_box(m);
+	int32_t gap = server.enable_gaps ? m->gappih : 0;
+	int32_t top = m->w.y + (server.enable_gaps ? m->gappov : 0);
+	int32_t nl = 0, nr = 0, bottom_l = top, bottom_r = top;
+	Client *o;
+
+	wl_list_for_each(o, &server.clients, link) {
+		if (o == c || !o->isstaged || !VISIBLEON(o, m))
+			continue;
+		if (o->geom.x + o->geom.width / 2 < s.x) {
+			nl++;
+			bottom_l = MANGO_MAX(bottom_l, o->geom.y + o->geom.height + gap);
+		} else {
+			nr++;
+			bottom_r = MANGO_MAX(bottom_r, o->geom.y + o->geom.height + gap);
+		}
+	}
+
+	bool left = nl <= nr;
+	int32_t side_w = left ? s.x - m->w.x : m->w.x + m->w.width - (s.x + s.width);
+	int32_t bw2 = 2 * (int32_t)c->bw;
+	int32_t lw = c->isstaged ? c->stage_lw : c->geom.width - bw2;
+	int32_t lh = c->isstaged ? c->stage_lh : c->geom.height - bw2;
+	if (lw <= 0 || lh <= 0)
+		return;
+	float sc = MANGO_MIN(STAGE_SCALE_MAX, (float)(side_w - 2 * gap - bw2) / lw);
+	int32_t w = (int32_t)roundf(lw * sc) + bw2;
+	int32_t h = (int32_t)roundf(lh * sc) + bw2;
+	int32_t y = left ? bottom_l : bottom_r;
+	if (y + h > m->w.y + m->w.height)
+		y = top;
+
+	stage_client(c, (struct wlr_box){
+						.x = left ? s.x - gap - w : s.x + s.width + gap,
+						.y = y,
+						.width = w,
+						.height = h,
+					});
+}
+
+static void stage_tile(Monitor *m, Client **tiles, int32_t n) {
+	struct wlr_box s = stage_center_box(m);
+	int32_t gi = server.enable_gaps ? m->gappih : 0;
+	int32_t go_h = server.enable_gaps ? m->gappoh : 0;
+	int32_t go_v = server.enable_gaps ? m->gappov : 0;
+	struct wlr_box in = {
+		.x = s.x + go_h,
+		.y = s.y + go_v,
+		.width = s.width - 2 * go_h,
+		.height = s.height - 2 * go_v,
+	};
+	int32_t half_w = (in.width - gi) / 2;
+	int32_t half_h = (in.height - gi) / 2;
+	struct wlr_box left = {in.x, in.y, half_w, in.height};
+	struct wlr_box right = {in.x + half_w + gi, in.y, in.width - half_w - gi,
+							in.height};
+	struct wlr_box boxes[STAGE_CENTER_MAX];
+
+	switch (n) {
+	case 1:
+		boxes[0] = in;
+		break;
+	case 2:
+		boxes[0] = left;
+		boxes[1] = right;
+		break;
+	case 3:
+		boxes[0] = left;
+		boxes[1] = (struct wlr_box){right.x, in.y, right.width, half_h};
+		boxes[2] = (struct wlr_box){right.x, in.y + half_h + gi, right.width,
+									in.height - half_h - gi};
+		break;
+	default:
+		boxes[0] = (struct wlr_box){left.x, in.y, left.width, half_h};
+		boxes[1] = (struct wlr_box){right.x, in.y, right.width, half_h};
+		boxes[2] = (struct wlr_box){left.x, in.y + half_h + gi, left.width,
+									in.height - half_h - gi};
+		boxes[3] = (struct wlr_box){right.x, in.y + half_h + gi, right.width,
+									in.height - half_h - gi};
+		break;
+	}
+
+	for (int32_t i = 0; i < n; i++)
+		client_tile_resize(tiles[i], boxes[i], 0);
+}
+
+void stage(Monitor *m) {
+	Client *c, *tiles[STAGE_CENTER_MAX];
+	int32_t n = 0;
+
+	wl_list_for_each(c, &server.clients, link) {
+		if (!VISIBLEON(c, m) || c->iskilling)
+			continue;
+		if (c->isstaged) {
+			// Leaving overview drops the card; stashed windows need it back.
+			if (!c->ov_card_tree && client_surface(c)->mapped)
+				overview_backup_surface(c);
+			continue;
+		}
+		if (!ISTILED(c))
+			continue;
+		if (n < STAGE_CENTER_MAX)
+			tiles[n++] = c;
+		else
+			stage_stash_free(m, c);
+	}
+
+	if (n > 0)
+		stage_tile(m, tiles, n);
+}
+
+static void shake_reset(Client *c) {
+	shake.c = c;
+	shake.ext = server.cursor->x;
+	shake.dir = 0;
+	shake.nflips = 0;
+	shake.fired = false;
+}
+
+// Shaking the dragged window pushes everything else out to tidy side columns.
+static void stage_shake(Monitor *m, Client *grabbed) {
+	Client *c;
+	wl_list_for_each(c, &server.clients, link) {
+		if (c != grabbed && VISIBLEON(c, m) && ISTILED(c))
+			stage_client(c, c->geom);
+	}
+	stage_align_sides(m, grabbed);
+	arrange(m, false, false);
+}
+
+static void stage_track_shake(Client *c, uint32_t time) {
+	double x = server.cursor->x;
+	if (shake.c != c)
+		shake_reset(c);
+	if (shake.fired || time == 0)
+		return;
+
+	if (shake.dir == 0) {
+		if (fabs(x - shake.ext) >= STAGE_SHAKE_TRAVEL) {
+			shake.dir = x > shake.ext ? 1 : -1;
+			shake.ext = x;
+		}
+		return;
+	}
+	if ((x - shake.ext) * shake.dir > 0) {
+		shake.ext = x;
+		return;
+	}
+	if ((shake.ext - x) * shake.dir < STAGE_SHAKE_TRAVEL)
+		return;
+
+	shake.dir = -shake.dir;
+	shake.ext = x;
+	memmove(shake.flips, shake.flips + 1,
+			sizeof(shake.flips[0]) * (STAGE_SHAKE_FLIPS - 1));
+	shake.flips[STAGE_SHAKE_FLIPS - 1] = time;
+	if (shake.nflips < STAGE_SHAKE_FLIPS)
+		shake.nflips++;
+
+	if (shake.nflips == STAGE_SHAKE_FLIPS &&
+		time - shake.flips[0] <= STAGE_SHAKE_WINDOW_MS) {
+		Monitor *m = monitor_at_point(server.cursor->x, server.cursor->y);
+		if (is_stage_layout(m)) {
+			shake.fired = true;
+			stage_shake(m, c);
+		}
+	}
+}
+
+bool stage_begin_move(Client *c, double x, double y) {
+	// Recorded for every move: a tile from another monitor may land here.
+	drag.c = c;
+	drag.was_staged = c->isstaged;
+	drag.origin = c->geom;
+
+	if (!is_stage_layout(c->mon))
+		return false;
+	if (!c->isstaged && !ISTILED(c))
+		return false;
+
+	shake_reset(c);
+
+	if (!c->isstaged) {
+		float rx = (float)(x - c->geom.x) / c->geom.width;
+		float ry = (float)(y - c->geom.y) / c->geom.height;
+		stage_client(c, c->geom);
+		struct wlr_box box = stage_box_at(c, 0, 0, STAGE_SCALE_MAX);
+		box.x = (int32_t)round(x - rx * box.width);
+		box.y = (int32_t)round(y - ry * box.height);
+		stage_client(c, box);
+		arrange(c->mon, false, false);
+	}
+	// Lets the regular drag code draw drop hints over center tiles.
+	c->drag_to_tile = true;
+	return true;
+}
+
+void stage_drag_motion(Client *c, uint32_t time) {
+	if (!c->isstaged)
+		return;
+	Monitor *m = monitor_at_point(server.cursor->x, server.cursor->y);
+	if (!is_stage_layout(m))
+		return;
+
+	stage_track_shake(c, time);
+
+	// Scale changes only the box on screen, so the client never re-renders.
+	float s = stage_scale_at(m, server.cursor->x);
+	c->stage_scale = s;
+	struct wlr_box old = c->geom;
+	struct wlr_box box = stage_box_at(c, 0, 0, s);
+	double rx = old.width > 0 ? (double)server.grab_offset_x / old.width : 0.5;
+	double ry = old.height > 0 ? (double)server.grab_offset_y / old.height : 0.5;
+	server.grab_offset_x = (int32_t)round(rx * box.width);
+	server.grab_offset_y = (int32_t)round(ry * box.height);
+	box.x = (int32_t)round(server.cursor->x) - server.grab_offset_x;
+	box.y = (int32_t)round(server.cursor->y) - server.grab_offset_y;
+	c->float_geom = box;
+}
+
+bool stage_drop(Client *c) {
+	Monitor *m = c->mon;
+	bool ours = drag.c == c;
+	drag.c = NULL;
+	shake.c = NULL;
+
+	if (!is_stage_layout(m)) {
+		if (!c->isstaged)
+			return false;
+		// Dropped on a monitor without the stage: join its tiling.
+		unstage_client(c);
+		c->drag_to_tile = true;
+		arrange(m, false, false);
+		return false;
+	}
+	if (!c->isstaged) {
+		if (!ours || !c->drag_to_tile ||
+			stage_in_center(m, server.cursor->x, server.cursor->y))
+			return false;
+		// A tile dragged in from another monitor stashes where it lands, at the
+		// size it had there.
+		c->drag_to_tile = false;
+		stage_client(c, c->geom);
+		c->stage_lw = drag.origin.width - 2 * (int32_t)c->bw;
+		c->stage_lh = drag.origin.height - 2 * (int32_t)c->bw;
+		stage_client(c, stage_box_at(c, server.cursor->x, server.cursor->y,
+									 stage_scale_at(m, server.cursor->x)));
+		arrange(m, false, false);
+		return true;
+	}
+
+	c->drag_to_tile = false;
+	if (!stage_in_center(m, server.cursor->x, server.cursor->y)) {
+		arrange(m, false, false);
+		return true;
+	}
+
+	Client *target = stage_tile_at_cursor(m, c);
+	int32_t n = stage_center_count(m, c);
+
+	if (n >= STAGE_CENTER_MAX && !target) {
+		// Full center and no tile under the cursor (a gap): back to the side.
+		if (ours && drag.was_staged)
+			stage_client(c, drag.origin);
+		else
+			stage_stash_free(m, c);
+		arrange(m, false, false);
+		return true;
+	}
+
+	unstage_client(c);
+	if (target) {
+		if (target->drop_direction == RIGHT || target->drop_direction == DOWN)
+			wl_list_safe_reinsert_next(&target->link, &c->link);
+		else
+			wl_list_safe_reinsert_prev(&target->link, &c->link);
+	}
+
+	if (n >= STAGE_CENTER_MAX) {
+		// Swap: the tile it landed on takes the dropped window's old spot.
+		if (ours && drag.was_staged) {
+			float s = stage_scale_at(m, drag.origin.x + drag.origin.width / 2.0);
+			stage_client(target, target->geom);
+			stage_client(target, stage_box_at(target,
+											  drag.origin.x +
+												  drag.origin.width / 2.0,
+											  drag.origin.y +
+												  drag.origin.height / 2.0,
+											  s));
+		} else {
+			stage_stash_free(m, target);
+		}
+	}
+
+	arrange(m, false, false);
+	return true;
+}
+
+static void stage_popup_handle_commit(struct wl_listener *listener,
+									  void *data) {
+	Popup *popup = wl_container_of(listener, popup, stage_commit);
+	if (popup->stage_client)
+		stage_layout_popups(popup->stage_client);
+}
+
+// Parents direct popups of a stashed window to their own node so they escape
+// the hidden real surface tree and can follow the scaled card.
+bool stage_popup_create(Popup *popup) {
+	struct wlr_xdg_popup *wlr_popup = popup->wlr_popup;
+	Client *c = NULL;
+	if (!wlr_popup->parent ||
+		toplevel_from_wlr_surface(wlr_popup->parent, &c, NULL) < 0 || !c ||
+		!c->isstaged || client_is_x11(c) ||
+		wlr_popup->parent != client_surface(c))
+		return false;
+
+	popup->stage_client = c;
+	popup->stage_carrier = wlr_scene_tree_create(c->scene);
+	wlr_popup->base->surface->data =
+		wlr_scene_xdg_surface_create(popup->stage_carrier, wlr_popup->base);
+	wl_list_insert(&c->stage_popups, &popup->stage_link);
+	popup->stage_commit.notify = stage_popup_handle_commit;
+	wl_signal_add(&wlr_popup->base->surface->events.commit,
+				  &popup->stage_commit);
+	stage_layout_popups(c);
+	return true;
+}
+
+void stage_popup_destroy(Popup *popup) {
+	if (!popup->stage_client)
+		return;
+	wl_list_remove(&popup->stage_link);
+	wl_list_remove(&popup->stage_commit.link);
+	wlr_scene_node_destroy(&popup->stage_carrier->node);
+	popup->stage_client = NULL;
+}
+
+void stage_layout_popups(Client *c) {
+	if (!c->isstaged || !c->stage_popups.prev || !c->mon)
+		return;
+
+	Popup *popup;
+	wl_list_for_each(popup, &c->stage_popups, stage_link) {
+		struct wlr_box g = popup->wlr_popup->current.geometry;
+		// Anchor point on the scaled content, relative to the client node.
+		int32_t ax = (int32_t)c->bw +
+					 (int32_t)roundf((g.x - c->card_clip_x) * c->card_scale_x);
+		int32_t ay = (int32_t)c->bw +
+					 (int32_t)roundf((g.y - c->card_clip_y) * c->card_scale_y);
+
+		// Slide back onto the usable area instead of flipping.
+		int32_t lx = c->animation.current.x + ax;
+		int32_t ly = c->animation.current.y + ay;
+		struct wlr_box *u = &c->mon->w;
+		if (lx + g.width > u->x + u->width)
+			ax -= lx + g.width - (u->x + u->width);
+		if (ly + g.height > u->y + u->height)
+			ay -= ly + g.height - (u->y + u->height);
+		if (lx < u->x)
+			ax += u->x - lx;
+		if (ly < u->y)
+			ay += u->y - ly;
+
+		// wlroots places the popup tree at g inside the carrier.
+		wlr_scene_node_set_position(&popup->stage_carrier->node, ax - g.x,
+									ay - g.y);
+		wlr_scene_node_raise_to_top(&popup->stage_carrier->node);
+	}
+}
+
+// Fullscreen and maximize pull a stashed window back to normal first.
+void stage_release(Client *c) {
+	unstage_client(c);
+}
