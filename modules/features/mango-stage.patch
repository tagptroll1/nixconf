+static struct ov_card_surface *card_entry_for_surface(Client *c,
+													  struct wlr_surface *s) {
+	struct ov_card_surface *entry;
+	wl_list_for_each(entry, &c->ov_card_surfaces, link) {
+		if (entry->surface == s)
+			return entry;
+	}
+	return NULL;
+}
+
+// Card buffers show scaled content, so hit tests map the card-local point back
+// to surface-local coordinates before asking the client's input region.
+bool card_buffer_point_accepts_input(struct wlr_scene_buffer *buffer,
+									 double *sx, double *sy) {
+	struct wlr_scene_surface *scene_surface =
+		wlr_scene_surface_try_from_buffer(buffer);
+	Client *c = buffer->node.data;
+	if (!scene_surface || !c || !c->ov_card_tree)
+		return false;
+
+	struct ov_card_surface *entry =
+		card_entry_for_surface(c, scene_surface->surface);
+	if (!entry || c->card_scale_x <= 0.f || c->card_scale_y <= 0.f)
+		return false;
+
+	*sx = (buffer->node.x + *sx) / c->card_scale_x + c->card_clip_x - entry->sx;
+	*sy = (buffer->node.y + *sy) / c->card_scale_y + c->card_clip_y - entry->sy;
+	return wlr_surface_point_accepts_input(scene_surface->surface, *sx, *sy);
+}
+
+// Maps a layout point over a card to coordinates local to one of its surfaces,
+// for input paths that bypass the scene hit test (pointer grabs).
+bool card_surface_coords(Client *c, struct wlr_surface *s, double lx,
+						 double ly, double *sx, double *sy) {
+	struct ov_card_surface *entry = c ? card_entry_for_surface(c, s) : NULL;
+	if (!entry || c->card_scale_x <= 0.f || c->card_scale_y <= 0.f)
+		return false;
+
+	int32_t ox, oy;
+	wlr_scene_node_coords(&c->ov_card_tree->node, &ox, &oy);
+	*sx = (lx - ox) / c->card_scale_x + c->card_clip_x - entry->sx;
+	*sy = (ly - oy) / c->card_scale_y + c->card_clip_y - entry->sy;
+	return true;
+}
+
+static void card_sync_surface(struct wlr_surface *surface, int sx, int sy,
+							  void *data) {
+	Client *c = data;
+	struct ov_card_surface *entry = card_entry_for_surface(c, surface);
+	if (!entry) {
+		overview_card_surface_add(surface, sx, sy, c);
+		entry = card_entry_for_surface(c, surface);
+		if (!entry)
+			return;
+	}
+	entry->sx = sx;
+	entry->sy = sy;
+	// Iteration runs bottom to top, so raising in order restores stacking.
+	wlr_scene_node_raise_to_top(&entry->buffer->node);
+}
