+    // omarchy-theme-set-freetube rewrites omarchy.css on every theme change.
+    // Watching the directory survives its atomic rename, so open windows
+    // retint without a restart.
+    const omarchyCssPath = path.join(userDataPath, 'omarchy.css')
+    let omarchyCssKey = null
+    const applyOmarchyCss = async () => {
+      const css = await asyncFs.readFile(omarchyCssPath, 'utf8').catch(() => null)
+      if (newWindow.isDestroyed()) {
+        return
+      }
+      const previousKey = omarchyCssKey
+      omarchyCssKey = css === null ? null : await newWindow.webContents.insertCSS(css)
+      if (previousKey !== null) {
+        await newWindow.webContents.removeInsertedCSS(previousKey)
+      }
+    }
+    newWindow.webContents.on('did-finish-load', () => {
+      // Inserted sheets die with the document they were inserted into.
+      omarchyCssKey = null
+      applyOmarchyCss().catch(console.error)
+    })
+    const omarchyCssWatcher = watch(userDataPath, (_, filename) => {
+      if (filename === 'omarchy.css') {
+        applyOmarchyCss().catch(console.error)
+      }
+    })
+    newWindow.on('closed', () => omarchyCssWatcher.close())
