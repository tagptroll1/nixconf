// -*- mode: jsonc -*-
[
  // ── Main bar: Corsair ultrawide (DP-1). Floating, not full width. ──
  {
    "name": "main",
    "output": "DP-1",
    "layer": "top",
    "height": 30,
    "spacing": 4,
    // Side margins shrink the bar on the very wide display.
    "margin-top": 0,
    "margin-left": 540,
    "margin-right": 540,
    "modules-left": [
      "ext/workspaces",
      "custom/media"
    ],
    "modules-center": [
      "clock",
      "custom/weather"
    ],
    "modules-right": [
      "custom/screenrecord",
      "idle_inhibitor",
      "custom/ps4battery",
      "cpu",
      "memory",
      "temperature",
      "bluetooth",
      "wireplumber",
      "tray",
      "custom/power"
    ],
    // mango exports tags over ext-workspace-v1, not the dwl ipc protocol.
    // Empty tags are marked hidden, so ignore-hidden keeps all 9 on the bar.
    "ext/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "ignore-hidden": false,
      "sort-by-name": true
    },
    "custom/weather": {
      "format": "{}",
      "return-type": "json",
      "interval": 600,
      "exec": "bash $HOME/.config/waybar/scripts/weather.sh"
    },
    // Recording indicator. Hidden unless recording; the script pushes updates
    // with SIGRTMIN+8, so no polling interval.
    "custom/screenrecord": {
      "format": "{}",
      "return-type": "json",
      "signal": 8,
      "exec": "bash $HOME/.config/waybar/scripts/recorder-status.sh",
      "on-click": "bash $HOME/.config/mango/scripts/screen-record.sh"
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": ""
      }
    },
    "tray": {
      "spacing": 10
    },
    "clock": {
      "timezone": "Europe/Oslo",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "format": "{:%H:%M  %d.%m.%Y}",
      "format-alt": "{:%d.%m.%Y}"
    },
    "cpu": {
      "format": "{usage}% 󰍛",
      "tooltip": false
    },
    "memory": {
      "format": "{}% "
    },
    "temperature": {
      // k10temp (CPU Tctl) lives under this stable PCI device; the hwmonN
      // index is not stable across boots, so list candidates and let waybar
      // use the first that opens.
      "hwmon-path": [
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon0/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon1/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon2/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon3/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon4/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon5/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon6/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon7/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon8/temp1_input",
        "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon9/temp1_input"
      ],
      "critical-threshold": 80,
      "format": "{temperatureC}°C {icon}",
      "format-icons": ["󰉬", "", "󰉪"]
    },
    // PS4 controller charge. hid_playstation only exposes the node while the pad
    // is connected, so the script hides the module rather than using exec-if.
    "custom/ps4battery": {
      "format": "{}",
      "return-type": "json",
      "interval": 60,
      "exec": "bash $HOME/.config/waybar/scripts/ps4-battery.sh"
    },
    "bluetooth": {
      "format-on": "󰂯",
      "format-off": "󰂲",
      "format-disabled": "󰂲",
      "format-connected": "󰂱 {num_connections}",
      "tooltip-format": "{controller_alias}\n{status}",
      "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
      "on-click": "ghostty --class=floating.bluetooth -e bluetui"
    },
    "wireplumber": {
      "format": "{volume}% {icon}",
      "format-muted": "󰝟",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "on-click": "ghostty --class=floating.volume -e pulsemixer"
    },
    "custom/media": {
      "format": "{icon} {text}",
      "return-type": "json",
      "max-length": 40,
      "format-icons": {
        "spotify": "",
        "default": ""
      },
      "escape": true,
      "exec": "waybar-mediaplayer 2> /dev/null", // wrapped python+playerctl, defined in configuration.nix
      // left-click: pause/resume the displayed player; launch spotify-tray if none running
      "on-click": "bash $HOME/.config/waybar/scripts/media-active.sh play-pause",
      "on-scroll-up": "bash $HOME/.config/waybar/scripts/media-active.sh next",
      "on-scroll-down": "bash $HOME/.config/waybar/scripts/media-active.sh previous",
      // right-click: GTK menu with media controls + quit
      "menu": "on-click-right",
      "menu-file": "$HOME/.config/waybar/media_menu.xml",
      "menu-actions": {
        "playpause": "bash $HOME/.config/waybar/scripts/media-active.sh play-pause",
        "next": "bash $HOME/.config/waybar/scripts/media-active.sh next",
        "prev": "bash $HOME/.config/waybar/scripts/media-active.sh previous",
        "mute": "bash $HOME/.config/waybar/scripts/spotify-mute.sh",
        "focus_spotify": "bash $HOME/.config/waybar/scripts/media-active.sh focus-spotify",
        "quit": "pkill spotify"
      }
    },
    "custom/power": {
      "format": "⏻ ",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "$HOME/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown now",
        "reboot": "reboot",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate"
      }
    }
  },

  // ── Side bar: Philips (DP-3). Clock only, centered floating pill. ──
  {
    "name": "side",
    "output": "DP-3",
    "layer": "top",
    "height": 30,
    "margin-top": 0,
    "modules-left": [],
    "modules-center": [
      "clock"
    ],
    "modules-right": [],
    "clock": {
      "timezone": "Europe/Oslo",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "format": "{:%H:%M  %d.%m.%Y}",
      "format-alt": "{:%d.%m.%Y}"
    }
  }
]
