theme = Rose Pine
font-family = "Fira Code"

# The clipboard picker pastes with Shift+Insert; ghostty's default pastes the
# primary selection there instead.
keybind = shift+insert=paste_from_clipboard

# Warm rose-pine overrides — orange/pink lean
background = 24191c
foreground = f7ebe8
cursor-color = ebbcba
selection-background = 3a2a2e
selection-foreground = e8d3cf

# warm pink/orange accents over rose-pine palette
palette = 1=eb6f92
palette = 3=f6a878
palette = 9=eb8f9c
palette = 11=f7b48a

# Omarchy theme switching. omarchy-theme-set renders this file from the picked
# theme's colors.toml; ghostty applies an included file after the one that
# includes it, so it overrides the palette above whenever a theme is staged.
# The leading ? keeps ghostty quiet before the first theme has been set.
config-file = ?~/.local/state/omarchy/current/theme/ghostty.conf
