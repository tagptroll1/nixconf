/*
 * Firewatch — warm rose-pine launcher.
 * Matches waybar: translucent dark plum, soft coral accent, rounded.
 */

* {
    bg0:     rgba(24, 16, 20, 0.88);   /* window — frosted dark plum   */
    bg1:     rgba(58, 32, 43, 0.55);   /* inputbar / mode pill         */
    sel:     rgba(232, 98, 74, 0.18);  /* selected row tint            */
    fg0:     #f7ebe8;                  /* primary text                  */
    fg1:     #f0cdbd;                  /* muted coral                   */
    accent:  #e8624a;                  /* coral highlight               */
    rose:    #eb6f92;                  /* pink                          */
    gold:    #f6a878;                  /* orange                        */
    urgent:  #d9533f;
    trans:   rgba(0, 0, 0, 0.0);

    background-color: transparent;
    text-color:       @fg0;
    spacing:          0;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    border-radius:    18px;
    border:           2px;
    border-color:     rgba(232, 98, 74, 0.35);
    background-color: @bg0;
    padding:          0;
}

mainbox {
    padding:  18px;
    spacing:  14px;
    children: [ inputbar, message, listview ];
}

/* ── search bar ─────────────────────────────────────────────── */
inputbar {
    background-color: @bg1;
    border-radius:    12px;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:   @accent;
    font:         "JetBrainsMono Nerd Font 12";
    str:          "";
    vertical-align: 0.5;
}

entry {
    placeholder:        "Search…";
    placeholder-color:  @fg1;
    text-color:         @fg0;
    cursor:             text;
    vertical-align:     0.5;
}

/* ── results ────────────────────────────────────────────────── */
listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    spacing:      4px;
    padding:      4px 0px 0px 0px;
}

element {
    padding:       10px 14px;
    spacing:       12px;
    border-radius: 10px;
    text-color:    @fg1;
}

element normal active   { text-color: @gold; }
element normal urgent   { text-color: @urgent; }

element selected normal {
    background-color: @sel;
    text-color:       @fg0;
    border:           0px 0px 0px 3px;
    border-color:     @accent;
}
element selected active {
    background-color: @sel;
    text-color:       @gold;
    border:           0px 0px 0px 3px;
    border-color:     @accent;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

/* ── mode switcher / messages ───────────────────────────────── */
message {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: @bg1;
}
textbox {
    text-color: @fg1;
}
